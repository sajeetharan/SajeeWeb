{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sajeetharan-dev",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-18",
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "HIRE_ASSISTANT_ENABLED": "false",
  },
  "ratelimits": [
    {
      "name": "HIRE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "HIRE_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": ["/**"],
  },
  "routes": [
    { "pattern": "www.sajeetharan.dev", "custom_domain": true },
    { "pattern": "sajeetharan.dev", "custom_domain": true },
  ],
}
